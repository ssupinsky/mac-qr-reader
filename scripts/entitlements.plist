<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for the ad-hoc signed bundle (docs/SECURITY.md §6.3).
     allow-jit: V8 needs MAP_JIT. disable-library-validation: required because ad-hoc code
     has no Team ID, so library validation would refuse to load Electron Framework.
     Deliberately absent: allow-dyld-environment-variables, allow-unsigned-executable-memory,
     get-task-allow (debugger attach), any device/TCC entitlement. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
